# Server configuration.
PORT=3000
# Set NODE_ENV=production in the hosting platform, not in the local .env file.
SESSION_SECRET=

# GEMINI_API_KEY: Required only if Gemini AI features are enabled.
GEMINI_API_KEY=

# APP_URL: The canonical public URL where this portal is hosted (set to https://digcowerri.com when custom domain is mapped).
APP_URL=https://digcowerri.com

# ADMIN_BOOTSTRAP_PASSCODE: Optional server-side passcode for claiming or resetting initial administrator provisioning.
ADMIN_BOOTSTRAP_PASSCODE=

# SUPABASE_URL & SUPABASE_ANON_KEY: Reserved for a future Supabase-backed data layer.
# The current server uses SQLite and does not read these values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RESEND_API_KEY & EMAIL_FROM: Optional transactional email configuration for password reset delivery.
RESEND_API_KEY=
EMAIL_FROM="DIGC Owerri Fellowship <no-reply@digcowerri.com>"
